---
import '../../styles/admin.css';
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="same-origin"/><title>Administración · Daeva Companion</title><link rel="icon" href="/assets/aion2-logo.png"/></head>
<body>
 <aside class="admin-sidebar"><a class="admin-brand" href="/#home"><img src="/assets/aion2-logo.png" alt="AION 2"/><span>Daeva<small>ADMINISTRACIÓN</small></span></a><p class="admin-eyebrow">CENTRO DE CONTROL</p><nav aria-label="Administración"><button data-view="overview" class="selected"><i data-lucide="layout-dashboard"></i>Visión general</button><button data-view="accounts"><i data-lucide="users"></i>Cuentas</button><button data-view="subscriptions"><i data-lucide="crown"></i>Suscripciones</button><button data-view="devices"><i data-lucide="monitor"></i>Dispositivos</button><button data-view="verifications"><i data-lucide="shield-check"></i>Verificaciones</button><button data-view="payments"><i data-lucide="wallet"></i>Pagos</button><button data-view="audit"><i data-lucide="scroll-text"></i>Registro de cambios</button><button data-view="service"><i data-lucide="activity"></i>Estado del servicio</button><button data-view="x-companion"><i data-lucide="monitor"></i>Centro del ejecutable</button><button data-view="x-releases"><i data-lucide="arrow-up-right"></i>Versiones y descargas</button><button data-view="x-quality"><i data-lucide="database"></i>Calidad de datos</button><button data-view="x-tickets"><i data-lucide="mail"></i>Soporte</button><button data-view="x-staff"><i data-lucide="users"></i>Equipo y permisos</button><button data-view="x-security"><i data-lucide="lock"></i>Seguridad</button><button data-view="x-metrics"><i data-lucide="activity"></i>Actividad</button><button data-view="x-notices"><i data-lucide="calendar"></i>Avisos y mantenimiento</button><button data-view="x-marketing"><i data-lucide="crown"></i>Streamers y descuentos</button></nav><div class="admin-sidebar-foot"><span class="admin-dot"></span>Acceso restringido<a href="/#home">Volver a la web <i data-lucide="arrow-up-right"></i></a></div></aside>
 <div class="admin-shell"><header class="admin-top"><span>Daeva Companion <b>/</b> Administración</span><div><span id="admin-user"></span><button id="admin-refresh" title="Actualizar datos" aria-label="Actualizar datos"><i data-lucide="refresh-cw"></i></button><button id="admin-logout" hidden>Cerrar sesión</button></div></header>
 <main><div class="admin-heading"><div><p class="admin-eyebrow">EL CONTROL DE TU COMUNIDAD</p><h1 id="admin-title">Visión general</h1><p id="admin-description">Cuentas, conexiones y acceso. Todo en un mismo lugar.</p></div><span class="admin-badge">DAEVA · ADMIN</span></div><div id="admin-status" role="status" aria-live="polite"></div>
 <section id="admin-access"><div class="admin-login"><i data-lucide="shield-check"></i><h2>Tu acceso de administrador</h2><p>Usa tu cuenta Daeva. La sesión es compartida con la web.</p><form id="admin-login-form"><label>Usuario o correo<input id="admin-login-user" autocomplete="username" required maxlength="254"/></label><label>Contraseña<input id="admin-login-password" type="password" autocomplete="current-password" required minlength="10" maxlength="128"/></label><button class="admin-button" type="submit">Entrar al panel <i data-lucide="arrow-right"></i></button></form><a href="/#home">Recuperar mi cuenta desde la web ↗</a></div></section>
 <section id="admin-workspace" hidden><div id="admin-toolbar" class="admin-toolbar" hidden><form id="admin-filter-form"><label class="admin-search"><i data-lucide="search"></i><input id="admin-search" placeholder="Buscar usuario o correo…" aria-label="Buscar"/></label><select id="admin-filter-status" aria-label="Estado de cuenta"><option value="">Todos los estados</option><option value="active">Activa</option><option value="suspended">Suspendida</option></select><select id="admin-filter-role" aria-label="Rol"><option value="">Todos los roles</option><option value="user">Usuario</option><option value="admin">Administrador</option></select><select id="admin-filter-plan" aria-label="Plan"><option value="">Todos los planes</option><option value="free">Gratuito</option><option value="plus">Plus activo</option><option value="expired">Plus caducado</option><option value="cancelled">Plus retirado</option></select><select id="admin-filter-verification" aria-label="Estado de verificación"><option value="">Todas las pruebas</option><option value="pending">En curso</option><option value="observed">Pendiente de validación</option><option value="expired">Caducada</option><option value="verified">Verificada</option></select><button class="admin-button secondary" type="submit">Filtrar</button></form><button id="admin-export" class="admin-button secondary">Exportar esta página</button></div><div id="admin-content"></div><div id="admin-pagination" hidden><span id="admin-total"></span><div><button id="admin-prev" class="admin-button secondary">← Anterior</button><span id="admin-page"></span><button id="admin-next" class="admin-button secondary">Siguiente →</button></div></div></section>
 <footer>DAEVA COMPANION <span>Las acciones administrativas quedan registradas.</span></footer></main></div>
 <dialog id="admin-detail"><header class="admin-dialog-header"><div><p class="admin-eyebrow">FICHA DE CUENTA</p><h2 id="admin-detail-title">Cuenta</h2></div><button id="admin-detail-close" class="admin-icon" aria-label="Cerrar ficha"><i data-lucide="x"></i></button></header><div id="admin-detail-content"></div></dialog>
 <dialog id="admin-confirm"><form id="admin-confirm-form"><div class="admin-dialog-header"><h2 id="admin-confirm-title">Confirmar cambio</h2><button id="admin-confirm-close" type="button" class="admin-icon" aria-label="Cancelar"><i data-lucide="x"></i></button></div><p id="admin-confirm-description"></p><label id="admin-days-label" hidden>Duración de la cortesía (días)<input id="admin-days" type="number" min="1" max="366" value="30"/></label><label id="admin-new-name-label" hidden>Nuevo nombre de usuario<input id="admin-new-name" pattern="[a-z0-9_]{3,32}" maxlength="32"/></label><label>Motivo del cambio<textarea id="admin-reason" required minlength="5" maxlength="500" rows="3" placeholder="Indica por qué realizas esta acción…"></textarea></label><label>Confirma el nombre de la cuenta<input id="admin-confirm-name" autocomplete="off" required/></label><p id="admin-confirm-error" role="status"></p><div class="admin-dialog-actions"><button id="admin-confirm-cancel" class="admin-button secondary" type="button">Cancelar</button><button id="admin-confirm-submit" class="admin-button" type="submit">Confirmar cambio</button></div></form></dialog>
 <script>import '../../scripts/admin.ts';</script>
</body></html>
