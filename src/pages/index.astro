---
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';
import '../styles/product.css';
import '../styles/home.css';
import Home from '../components/Home.astro';
import AccountDialog from '../components/AccountDialog.astro';
import AccountSettings from '../components/AccountSettings.astro';
import '../styles/account-settings.css';
import '../styles/encyclopedia.css';
import Encyclopedia from '../components/Encyclopedia.astro';
import '../styles/ux.css';
import '../styles/profile-hub.css';
import '../styles/interface.css';
---
<!doctype html>
<html lang="es">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Tu compañero de AION 2: compara personajes, descubre qué mejorar y organiza tu camino por Atreia."/><title>AION 2 · Daeva Companion</title><link rel="icon" href="/assets/aion2-logo.png" type="image/png"/></head>
<body class="home-view">
 <a class="skip-link" href="#main-content">Saltar al contenido</a>
 <aside class="sidebar" id="site-navigation" aria-label="Navegación del sitio">
  <button id="navigation-close" class="icon-button" aria-label="Cerrar navegación">×</button>
  <a class="brand" href="/" aria-label="Daeva Companion inicio"><img class="game-logo" src="/assets/aion2-logo.png" alt="AION 2"/><span>Daeva<small>COMPANION</small></span></a>
  <div class="nav-label">TU AVENTURA</div>
  <nav aria-label="Principal">
   <button class="nav-item active" data-view="home"><i data-lucide="house"></i>Inicio</button>
   <a class="nav-item nav-download" href="/#home?download=1" data-download-open><i data-lucide="download"></i>Descargas</a>
   <div id="personal-navigation" hidden>
    <div class="nav-label">MI AVENTURA <span id="personal-nav-name">Elige tu personaje</span></div>
    <button class="nav-item" data-own-profile><i data-lucide="user-round"></i>Mi perfil</button>
    <button class="nav-item" data-view="equipment"><i data-lucide="swords"></i>Equipo y habilidades</button>
    <button class="nav-item" data-view="daevanion"><i data-lucide="sparkles"></i>Daevanion</button>
    <button class="nav-item" data-view="roadmap"><i data-lucide="route"></i>Hoja de ruta</button>
    <button class="nav-item" data-view="planner"><i data-lucide="sparkles"></i>Planificar habilidades</button>
    <button class="nav-item" data-view="history"><i data-lucide="chart-no-axes-combined"></i>Mi progreso</button>
    <button class="nav-item" data-view="pets"><i data-lucide="paw-print"></i>Mis mascotas</button>
   </div>

   <div class="nav-label nav-explore-label">EXPLORAR ATREIA</div>
   <button class="nav-item" data-view="overview" title="Comparar builds"><i data-lucide="layout-dashboard"></i>Comparar builds</button>
   <button class="nav-item" data-view="map"><i data-lucide="map"></i>Mapa de Atreia</button>
   <button class="nav-item" data-view="database"><i data-lucide="book-open"></i>Base de datos</button>
   <details class="database-navigation"><summary>Explorar la enciclopedia</summary><div><button data-database-section="items">Objetos y categorías</button><button data-database-section="npc">Criaturas y PNJ</button><button data-database-section="quests">Misiones</button><button data-database-section="dungeons">Mazmorras</button><button data-database-section="recipes">Fabricación</button><button data-database-section="pets">Catálogo de mascotas</button><button data-database-section="wings">Alas</button><button data-database-section="titles">Títulos</button><button data-database-section="skills">Habilidades</button><button data-database-section="calculators">Calculadoras</button><button data-database-section="more">Más herramientas</button></div></details>
   <button class="nav-item" data-view="damage"><i data-lucide="calculator"></i>Daño teórico</button>
   <button class="nav-item" data-view="events"><i data-lucide="clock"></i>Eventos</button>
   <button class="nav-item" data-view="ranking"><i data-lucide="trophy"></i>Clasificación</button>
  </nav>
  <div class="sidebar-bottom"><div class="faction-symbol">✧</div><p>Un paso más cerca<br/><strong>de tu próxima aventura.</strong></p><a href="https://aion2.plaync.com/es-es/index?redirect=false" target="_blank" rel="noopener">Explorar AION 2 <i data-lucide="arrow-up-right"></i></a><div class="connection"><span></span>Datos de NCSOFT</div><small>Proyecto de fans · No oficial</small></div>
 </aside>
 <button id="navigation-backdrop" aria-label="Cerrar navegación" tabindex="-1" hidden></button>
 <div class="workspace">
  <header class="topbar"><div class="breadcrumbs">Atreia <span>/</span> <strong id="crumb">Mi personaje</strong></div><div id="event-ticker"></div><div class="top-actions"><label class="site-lang" data-no-translate><span class="sr-only">Idioma · Language</span><select id="site-lang" aria-label="Idioma · Language · Idioma · Langue"><option value="es">ES</option><option value="en">EN</option><option value="pt">PT</option><option value="fr">FR</option></select></label><a class="button secondary header-download" href="/#home?download=1" data-download-open aria-label="Descargas de FullAIon2Companion"><i data-lucide="download"></i><span>Descargas</span></a><button id="search-open" class="quiet"><i data-lucide="search"></i><span>Buscar personaje</span><kbd>/</kbd></button><button id="refresh" class="icon-button" aria-label="Actualizar datos"><i data-lucide="refresh-cw"></i></button><div class="account-anchor"><button id="account-open" class="button secondary" aria-haspopup="menu" aria-expanded="false" aria-controls="account-dropdown">Mi cuenta</button><div class="mini-avatar" id="mini-avatar" role="button" tabindex="0" aria-label="Abrir menú de cuenta" aria-haspopup="menu" aria-expanded="false" aria-controls="account-dropdown">D</div><div id="account-dropdown" class="account-dropdown" role="menu" aria-label="Mi cuenta" hidden><div class="account-menu-identity"><strong id="account-menu-name">Tu cuenta Daeva</strong><small id="account-menu-state">Conecta tu aventura</small></div><button role="menuitem" data-settings-open="general"><i data-lucide="settings"></i>Configuración de cuenta</button><button role="menuitem" data-own-profile hidden><i data-lucide="user-round"></i>Mi personaje</button><button role="menuitem" data-settings-open="desktop"><i data-lucide="monitor"></i>Aplicación de escritorio</button><button role="menuitem" data-settings-open="donate"><i data-lucide="heart"></i>Apóyanos<span class="account-menu-plan">Todo gratis</span></button><button role="menuitem" id="account-menu-logout" class="account-menu-exit" hidden><i data-lucide="log-out"></i>Cerrar sesión</button></div></div></div></header>
  <main id="main-content" tabindex="-1">
   <div class="page-heading"><div><div class="eyebrow">TU CAMINO POR ATREIA</div><h1 id="page-title">Cada mejora cuenta.</h1><p id="page-subtitle">Conoce tu build. Encuentra tu siguiente paso.</p></div><div class="heading-actions"><span id="freshness" class="muted">Cargando personajes…</span><button class="button secondary" id="export"><i data-lucide="download"></i>Exportar plan</button></div></div>
   <div id="notice" role="status" aria-live="polite"></div>
   <div id="personal-context" class="personal-context" hidden></div>
   <div id="personal-empty" class="panel personal-empty" role="status" hidden></div>
   <Home/>
   <section id="view-pets" class="view"><div class="section-heading"><h2>Mi colección de mascotas</h2><span class="tag">SINCRONIZADA CON EL EJECUTABLE</span></div><p class="settings-lead">Tu colección y su avance diario, vinculados al personaje activo.</p><div id="pets-page-content"></div></section>
   <section id="view-overview" class="view">
    <div id="hero"></div>
    <nav class="compare-jumps" aria-label="Secciones de comparación"><a href="#compare-summary">Resumen</a><a href="#compare-attributes">Atributos</a><a href="#compare-gear">Equipo</a><a href="#compare-skills">Habilidades</a><a href="#compare-boards">Daevanion</a><a href="#compare-extras">Otros efectos</a></nav>
    <section id="compare-summary" class="comparison-section"><div class="section-heading"><h2>La distancia entre ambas builds</h2><span class="tag">LECTURA NCSOFT</span></div><div id="metrics" class="comparison-panel"></div></section>
    <div class="section-heading"><h2>Qué revisar primero</h2><button class="text-button" data-view="roadmap">Abrir hoja de ruta <i data-lucide="arrow-right"></i></button></div><div id="priorities" class="next-steps"></div>
    <section id="compare-attributes" class="comparison-section"><div class="section-heading"><h2>Atributos y sus efectos</h2><span class="muted">Tu valor · atributo · referencia</span></div><div id="stats" class="comparison-panel"></div><p class="panel-foot">Más puntos no siempre significan una mejor build. Compara los efectos y el objetivo JcE o JcJ.</p></section>
    <section id="compare-gear" class="comparison-section"><div class="section-heading"><h2>Equipo, pieza por pieza</h2><span class="muted">Selecciona una pieza para ver atributos y piedras</span></div><div id="weapon-comparison"></div><div id="overview-equipment" class="comparison-panel"></div></section>
    <section id="compare-skills" class="comparison-section"><div class="section-heading"><h2>Habilidades y estigmas</h2><span class="muted">Nivel y selección de cada build</span></div><div id="overview-skills" class="comparison-panel"></div></section>
    <section id="compare-boards" class="comparison-section"><div class="section-heading"><h2>Daevanion, tablero a tablero</h2><button class="text-button" data-view="daevanion">Ver los nodos <i data-lucide="arrow-right"></i></button></div><div id="board-summary" class="comparison-panel"></div></section>
    <section id="compare-extras" class="comparison-section"><div class="section-heading"><h2>Títulos, mascota y alas</h2></div><div id="overview-extras" class="comparison-panel"></div></section>
   </section>
   <section id="view-equipment" class="view"><div class="section-heading"><h2>Equipo frente a frente</h2><label class="switch-label"><input type="checkbox" id="differences"/>Solo diferencias</label></div><div class="panel"><div id="equipment-table"></div></div><div class="section-heading"><h2>Habilidades y estigmas</h2></div><div id="skills" class="skills-grid"></div><div class="section-heading"><h2>Títulos, mascota y alas</h2></div><div id="extras" class="extras-grid"></div></section>
   <section id="view-daevanion" class="view"><div class="section-heading"><h2>Una ruta, nodo a nodo</h2><select id="board-select" aria-label="Seleccionar tablero"></select></div><div class="legend board-legend"><span class="dot gold"></span>Lo tienes <span class="dot blue"></span>Solo referencia <span class="dot mixed"></span>Ambos <span class="dot gray"></span>Sin activar</div><div class="board-layout"><div class="panel board-panel"><div id="node-board" class="node-board"></div></div><div class="panel node-detail" id="node-detail"><div class="eyebrow">COMPARA LOS EFECTOS</div><h2>Elige un nodo</h2><p>Selecciona un punto del tablero para ver qué aporta a cada build.</p></div></div><div id="board-effects" class="extras-grid"></div></section>
   <section id="view-roadmap" class="view"><div class="roadmap-toolbar"><div><h2>De tu build a tu próxima meta</h2><p>Prioridades orientativas a partir de diferencias reales. Decide según tu presupuesto.</p></div><select id="mode" aria-label="Objetivo de la build"><option value="pve">Objetivo: JcE</option><option value="pvp">Objetivo: JcJ</option></select></div><div id="roadmap"></div></section>
   <section id="view-map" class="view"><div class="map-layout"><aside class="map-filters"><div class="atlas-brand"><img src="/assets/aion2-logo.png" alt="AION 2"/><div><strong>Atlas de Atreia</strong><span id="map-sync">Progreso local</span></div></div><nav class="map-tabs"><button class="active" data-map-tab="markers">Marcadores</button><button data-map-tab="notes">Notas</button><button data-map-tab="route">Mi ruta</button></nav><label class="map-selector-label" for="map-select">REGIÓN O MAZMORRA</label><select id="map-select" aria-label="Región o mazmorra"><option value="2">Altgard</option></select><div id="map-count"></div><input id="map-search" aria-label="Buscar marcadores" placeholder="Buscar criatura, PNJ o lugar…"/><div class="map-filter-actions"><button id="map-all">Ver todo</button><button id="map-clear">Ocultar todo</button><label><input type="checkbox" id="hide-visited"/>Ocultar visitados</label></div><div id="map-search-results" hidden></div><div id="map-categories"></div><div id="map-personal" hidden><p id="map-tool-help">Selecciona una herramienta y pulsa sobre el mapa.</p><button class="button secondary" id="map-add-note">Añadir nota</button><button class="button secondary" id="map-route-toggle">Dibujar ruta</button><button class="text-button" id="map-route-clear">Borrar ruta</button><div id="map-notes-list"></div></div></aside><div class="map-canvas-wrap"><div id="map" aria-label="Mapa interactivo de Atreia"></div><div class="map-floating-tools"><button id="map-me" class="icon-button" aria-label="Centrar en mí" title="Centrar en mí" hidden><i data-lucide="locate-fixed"></i></button><button id="map-events-toggle" class="icon-button" aria-label="Mostrar u ocultar eventos" title="Mostrar u ocultar eventos"><i data-lucide="clock"></i></button><button id="map-reset" class="icon-button" aria-label="Centrar mapa" title="Centrar mapa"><i data-lucide="compass"></i></button><button id="map-wide" class="icon-button" aria-label="Ampliar mapa" title="Ampliar mapa"><i data-lucide="maximize"></i></button></div><div id="map-me-status" class="map-me-status" role="status" hidden></div><div class="map-credit">Cartografía: InteractiveMap.app · Marcadores y progreso propios</div></div><aside class="map-events"><div class="map-event-heading"><i data-lucide="clock"></i><strong>Próximos eventos</strong><button id="map-events-close" class="icon-button" aria-label="Ocultar eventos">×</button></div><div class="map-event-clock"><strong id="map-clock"></strong><small>HORA DE TU REGIÓN</small><select id="event-region" aria-label="Región de eventos"><option value="-180">Sudamérica</option><option value="120">Europa</option><option value="-240">Norteamérica Este</option><option value="-420">Norteamérica Oeste</option><option value="540">Asia</option></select></div><div class="map-alert-actions"><button data-alert-enable>Activar sonido</button><button data-alert-test aria-label="Probar sonido de eventos">♪ Probar</button></div><div id="map-events-list"></div><p>Horarios comunitarios · Confirma dentro del juego</p></aside></div><div class="panel-foot">Tus visitas, notas y rutas se guardan al marcarlas. La ubicación en vivo del personaje no está disponible en la API oficial.</div></section>
   <section id="view-history" class="view"><div class="section-heading"><h2>Tu progreso, a tu ritmo</h2><button class="button" id="save-snapshot"><i data-lucide="bookmark-plus"></i>Guardar lectura</button></div><p>Guarda una lectura de tu personaje para comparar tu poder y nivel de objeto con el tiempo. Las lecturas se conservan en este navegador.</p><div class="panel" id="history"></div></section>
   <section id="view-database" class="view"><Encyclopedia/></section>
   <section id="view-events" class="view"><div class="section-heading"><div><h2>Próximos eventos</h2><p>Calendario comunitario por región. Cambia la región desde el atlas; verifica los horarios dentro del juego.</p></div><span class="tag" id="event-clock"></span></div><div class="alert-settings"><div><strong>Escucha el próximo evento</strong><p data-alert-status></p></div><button class="button" data-alert-enable>Activar sonido</button><button class="button secondary" data-alert-test>Probar sonido</button><label>Avisar antes<select id="alert-lead"><option value="1">1 minuto</option><option value="3" selected>3 minutos</option><option value="5">5 minutos</option><option value="10">10 minutos</option></select></label><label>Volumen<input id="alert-volume" type="range" min="0" max="1" step="0.05" value="0.35"/></label></div><div id="events-list" class="events-grid"></div></section>
   <section id="view-profile" class="view"><div id="character-profile"></div></section><section id="view-ranking" class="view"><div class="section-heading"><div><h2>Clasificación de personajes</h2><p id="ranking-description">Cargando lectura…</p></div><a class="text-button" id="ranking-source" href="https://aion2index.com/rankings?region=la" target="_blank" rel="noopener">Consultar fuente actual ↗</a></div><div class="ranking-controls"><label>Región<select id="ranking-region"><option value="la">Sudamérica</option><option value="eu">Europa</option><option value="nae">Norteamérica Este</option><option value="naw">Norteamérica Oeste</option><option value="as">Asia</option><option value="all">Todas</option></select></label><label>Servidor<select id="ranking-server"><option value="">Todos los servidores</option></select></label><label>Clase<select id="ranking-class"><option value="">Todas las clases</option><option value="gladiator">Gladiador</option><option value="templar">Templario</option><option value="assassin">Asesino</option><option value="ranger">Arquero</option><option value="sorcerer">Hechicero</option><option value="spiritmaster">Espiritualista</option><option value="cleric">Clérigo</option><option value="chanter">Cantor</option><option value="brawler">Luchador</option></select></label><button class="button secondary" id="ranking-refresh">Actualizar</button><button class="text-button" id="ranking-pvp">Ver lectura de puntos JcJ</button></div><div id="ranking-status" class="panel empty"></div><div class="panel" id="ranking-list"></div><p class="panel-foot">La clasificación por poder proviene de Aion2Index y sus primeros puestos se releen cada hora. Los puntos JcJ provienen de Aion2t y se muestran solo cuando la fuente los publica.</p></section>
   <section id="view-planner" class="view"><div class="section-heading"><div><h2>Planificador de habilidades</h2><p>Distribuye tus puntos y prepara tu barra. Datos de habilidades y costes importados de DBAion2.</p></div><button class="button secondary" id="planner-export">Exportar build</button></div><div class="planner-toolbar"><div id="planner-classes"></div><strong id="planner-class-name"></strong><label>Nivel<input id="planner-level" type="number" min="1" max="45" value="45"/></label><label>Puntos extra de habilidad<input id="planner-extra" type="number" min="0" max="1000" value="0"/></label><label>Puntos extra de estigma<input id="planner-stigma-extra" type="number" min="0" max="1000" value="0"/></label></div><div id="planner-budget"></div><div class="planner-layout"><div class="panel"><div class="account-tabs"><button data-planner-tab="active" class="active">Activas</button><button data-planner-tab="passive">Pasivas</button><button data-planner-tab="stigma">Estigmas</button></div><div id="planner-grid"></div></div><div class="panel" id="planner-detail"></div></div><div class="panel planner-bar-panel"><div class="section-heading"><h3>Tu barra de habilidades</h3><button id="planner-reset" class="text-button">Reiniciar plan</button></div><div id="planner-bar"></div><p class="muted">Añade habilidades desde su ficha; pulsa un espacio ocupado para quitarlo. Incluye en puntos extra solo los que hayas obtenido.</p></div></section>
   <section id="view-damage" class="view"><div class="section-heading"><h2>Una estimación para experimentar</h2><span class="tag">MODELO SIMPLIFICADO</span></div><div class="damage-layout"><div class="panel damage-inputs"><label>Ataque efectivo<input data-damage id="damage-attack" type="number" min="0" max="1000000" value="1000"/></label><label>Coeficiente de habilidad (%)<input data-damage id="damage-multiplier" type="number" min="0" max="10000" value="200"/></label><label>Probabilidad crítica (%)<input data-damage id="damage-crit" type="number" min="0" max="100" value="20"/></label><label>Daño crítico adicional (%)<input data-damage id="damage-critdamage" type="number" min="0" max="1000" value="50"/></label><label>Amplificación (%)<input data-damage id="damage-amp" type="number" min="0" max="1000" value="0"/></label></div><div class="panel damage-explanation"><div class="eyebrow">EXPLORA ESCENARIOS</div><div id="damage-output"></div><h3>Cómo se calcula</h3><p>Ataque × coeficiente × (1 + amplificación) × (1 + probabilidad crítica × daño crítico adicional).</p><p>Los valores iniciales son ejemplos editables. Este modelo no reproduce la fórmula completa de AION 2: omite defensa enemiga, precisión, resistencias, multigolpe, rotación y tiempos de habilidad. El poder de combate no se convierte en DPS.</p><a class="text-button" href="https://aion2.app/db/skills" target="_blank" rel="noopener">Consultar coeficientes de habilidades ↗</a></div></div></section>
   <footer><span>AION 2 <b>DAEVA COMPANION</b></span><a class="footer-donate" href="https://paypal.me/martincito45" target="_blank" rel="noopener noreferrer"><i data-lucide="heart"></i>Donar con PayPal</a><p>Personajes: NCSOFT · Cartografía: <a href="https://interactivemap.app/aion2/maps/es/altgard" target="_blank" rel="noopener">InteractiveMap.app</a> · Retratos de criaturas: <a href="https://aion2.th.gl/es/db/bestiary" target="_blank" rel="noopener">aion2.th.gl</a> · Assets © sus respectivos titulares.</p><a href="/endpoints/">Fuentes y datos <i data-lucide="arrow-up-right"></i></a></footer>
  </main>
 </div>
 <dialog id="search-dialog"><form id="search-form"><div class="dialog-heading"><div><span class="eyebrow">ENCUENTRA TU DAEVA</span><h2>Buscar personaje</h2></div><button type="button" class="icon-button" id="search-close" aria-label="Cerrar"><i data-lucide="x"></i></button></div><div class="search-fields"><label>Región<select id="search-region"><option value="la">Sudamérica</option><option value="eu">Europa</option><option value="naw">Norteamérica Oeste</option><option value="nae">Norteamérica Este</option><option value="as">Asia</option></select></label><label>Servidor<select id="search-server"><option value="">Todos los servidores</option></select></label></div><label>Nombre o enlace oficial<input id="search-keyword" required maxlength="600" placeholder="Darkni, EaSy o URL del personaje"/></label><button class="button" type="submit"><i data-lucide="search"></i>Buscar</button><p id="search-status" role="status">Escribe un nombre o pega un enlace oficial. También puedes buscar nombres de una sola letra.</p><div id="search-results"></div></form></dialog>
 <dialog id="item-dialog"><div class="dialog-heading"><h2>Detalle del equipo</h2><button id="item-close" class="icon-button" aria-label="Cerrar"><i data-lucide="x"></i></button></div><div id="item-content"></div></dialog>
 <dialog id="game-dialog"><button id="game-close" class="icon-button modal-close" aria-label="Cerrar ficha">×</button><div id="game-content"></div></dialog>
 <div id="event-alert-toast" role="status" aria-live="polite" hidden></div>
 <AccountDialog/><AccountSettings/>
 <dialog id="note-dialog"><form id="note-form"><div class="dialog-heading"><h2>Una nota en el mapa</h2><button type="button" id="note-close" class="icon-button" aria-label="Cerrar nota">×</button></div><label>Título<input id="note-name" required maxlength="80" placeholder="Punto para revisar"/></label><label>Nota<textarea id="note-text" maxlength="1500" rows="4" placeholder="Qué quieres recordar…"></textarea></label><button class="button" type="submit">Guardar nota</button></form></dialog>
 <script>import '../scripts/site-i18n';import '../scripts/app.ts';import '../scripts/site-operations';</script>
</body></html>
