{"id":2202045,"name":"Adiós, mi instructor","description":"Al enterarse de sus planes de abandonar Altgard, Baba corrió a la Asamblea. Te informó que los otros comerciantes se habían ido a buscarte un regalo de despedida después de escuchar la noticia, pero desaparecieron. Baba os pide que los traigáis sanos y salvos.","type":"District","typeName":"Regional","race":"Dark","levelMin":10,"levelMax":45,"region":"Altgard","steps":[{"order":1,"text":"Hazle un favor a Baba","goals":["hablar con baba"]},{"order":2,"text":"Encuentra a los comerciantes de Quai desaparecidos","goals":["Investiga las ruinas misteriosas"]},{"order":3,"text":"Dirígete a la ubicación indicada en la nota.","goals":["Ve a la pequeña casa cerca del Impetusium."]},{"order":4,"text":"Únete a Baba","goals":["hablar con baba"]},{"order":5,"text":"Ve al lugar donde están esperando tus alumnos.","goals":["ir a la casa pequeña"]}],"rewards":{"exp":3936438,"gold":100000,"items":[{"id":531900001,"count":1,"name":"Piedra de la sabiduría (encuadernada)","icon":"/assets/game/Icon_Usable_Potion_Skillpoint_003.webp","grade":"Special","originalName":"Wisdom Stone (Bound)"},{"id":531900003,"count":1,"name":"Cristal daevaniano (Vinculado)","icon":"/assets/game/Icon_Item_Usable_Potion_Skillpoint_004.webp","grade":"Special","originalName":"Daevanion Crystal (Bound)"},{"id":532540142,"count":1,"name":"Título: Mi instructor","icon":"/assets/game/Icon_Currency_Get_Title_03_001.webp","grade":"Legend","originalName":"Title: My Instructor"},{"id":534310010,"count":1,"name":"Obra de arte: Quai Merchants (encuadernado)","icon":"/assets/game/icon_AD_pic_D_r_NPC_M_ShugoB_01.webp","grade":"Rare","originalName":"Artwork: Quai Merchants (Bound)"}],"classItems":[]},"startNpc":{"id":2959165,"name":"Baba","originalName":"Baba"},"prev":null,"next":null,"originalName":"Farewell, My Instructor"}